// Static trainer assets and authoritative multiplayer room service.
{
  "name": "gto-trainer",
  "main": "server/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "BattleRoom" }]
  },
  "migrations": [{ "tag": "v1-battle-rooms", "new_sqlite_classes": ["BattleRoom"] }]
}
