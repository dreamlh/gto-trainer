{
  "name": "gto-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "dev:battle": "npm run build && wrangler dev --port 8787",
    "test:battle": "node --import tsx scripts/test-battle-game.ts",
    "test:battle:api": "node --import tsx scripts/test-battle-api.ts",
    "deploy": "npm run build && wrangler deploy",
    "test:battle:actions": "node --import tsx scripts/test-battle-actions.ts",
    "test:battle:pre-action": "node --import tsx scripts/test-battle-pre-action.ts",
    "test:battle:winning-cards": "node --import tsx scripts/test-battle-winning-cards.ts",
    "test:battle:layout": "node --import tsx scripts/test-battle-chip-layout.ts",
    "test:battle:stats": "node --import tsx scripts/test-battle-stats.ts",
    "test:battle:room": "node --import tsx scripts/test-battle-room-review.ts",
    "test:battle:presentation": "node --import tsx scripts/test-battle-presentation.ts",
    "test:battle:visuals": "node --import tsx scripts/test-battle-visuals.ts",
    "test:battle:audio": "node --import tsx scripts/test-battle-audio.ts",
    "test:poker:presentation": "node --import tsx scripts/test-poker-presentation.ts",
    "test:trainer:presentation": "node --import tsx scripts/test-trainer-presentation.ts",
    "test:trainer:events": "node --import tsx scripts/test-trainer-events.ts",
    "test:trainer:session": "node --import tsx scripts/test-trainer-session.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "wrangler": "^4.146.0"
  }
}
